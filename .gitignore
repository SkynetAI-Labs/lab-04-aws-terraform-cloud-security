# Terraform provider downloads
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform saved plans
*.tfplan
tfplan

# AWS credentials
.aws/
credentials
*.pem
*.key

# Environment files
.env
.env.*

# Python cache
__pycache__/
*.pyc

# IDE files
.vscode/
.idea/

# Python virtual environment
.venv/
